---
layout: base.njk
title: Gallery
nav: gallery
---
<style>
  .full-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 160px;
    gap: 1rem;
  }
  @media (max-width: 900px) { .full-gallery { grid-template-columns: repeat(2, 1fr); } }
</style>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow-badge">{{ gallery.badge }}</span>
    <h1>{{ gallery.hero_heading }}</h1>
    <p>{{ gallery.hero_text }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="full-gallery">
      {% for t in gallery.tiles %}
      <div class="tile {{ t.color }}">{{ t.emoji }} {{ t.label }}</div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="cta-banner" style="background:var(--sky);">
    <h2>{{ gallery.cta_heading }}</h2>
    <p>{{ gallery.cta_text }}</p>
    <a href="{{ gallery.cta_button_link }}" class="btn btn-light">{{ gallery.cta_button_text }}</a>
  </div>
</section>
