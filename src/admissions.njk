---
layout: base.njk
title: Admissions
nav: admissions
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow-badge">{{ admissions.badge }}</span>
    <h1>{{ admissions.hero_heading }}</h1>
    <p>{{ admissions.hero_text }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="steps-list">
      {% for s in admissions.steps %}
      <div class="step-row">
        <div class="step-num">{{ loop.index }}</div>
        <div>
          <h3>{{ s.title }}</h3>
          <p>{{ s.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head center">
      <h2>{{ admissions.fees_heading }}</h2>
      <p style="margin-left:auto;margin-right:auto;">{{ admissions.fees_subtext }}</p>
    </div>
    <table class="fee-table">
      <thead>
        <tr>
          <th>Program</th>
          <th>Age group</th>
          <th>Monthly fee</th>
          <th>Timing</th>
        </tr>
      </thead>
      <tbody>
        {% for row in admissions.fees %}
        <tr>
          <td>{{ row.program }}</td>
          <td>{{ row.age }}</td>
          <td>{{ row.fee }}</td>
          <td>{{ row.timing }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <div class="cta-banner">
    <h2>{{ admissions.cta_heading }}</h2>
    <p>{{ admissions.cta_text }}</p>
    <a href="{{ admissions.cta_button_link }}" class="btn btn-light">{{ admissions.cta_button_text }}</a>
  </div>
</section>
