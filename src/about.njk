---
layout: base.njk
title: About Us
nav: about
badge: "Our story"
hero_heading: "A school that started with one classroom and a garden."
hero_text: "Little Sparks opened in 2011 with 14 children and a single sunny room. Fifteen years on, the garden's bigger, the classrooms are full, and the promise hasn't changed: every child learns best when they feel safe, seen, and free to be curious."

approach_heading: "Our approach"
approach_text_1: "We follow a play-based curriculum built around three ideas: children learn through doing, through stories, and through each other. Structured lessons are short; open-ended play, building, and outdoor exploration take up the rest of the day."
approach_text_2: "Every teacher is trained in early-childhood education, and every classroom has two adults, so no child ever goes unnoticed."

values:
  - color: "var(--coral)"
    number: "1"
    title: "Kindness first."
    text: "Conflict is a chance to learn, not a reason to punish."
  - color: "var(--sky)"
    number: "2"
    title: "Curiosity over correctness."
    text: "A good question matters more than a right answer."
  - color: "var(--leaf)"
    number: "3"
    title: "Real childhood."
    text: "Mud, noise, and mess are part of learning, not a mess to avoid."
  - color: "var(--grape)"
    number: "4"
    title: "Partnership with parents."
    text: "You know your child best — we build on that."

teachers_heading: "Meet a few of our teachers"
teachers_subtext: "A small team that's been together for years, not months."
teachers:
  - icon: "👩‍🏫"
    name: "Ms. Ananya"
    text: "Lead teacher, Playgroup. With us since day one, in 2011."
  - icon: "👨‍🏫"
    name: "Mr. Rohan"
    text: "Lead teacher, Nursery. Runs our weekly music circle."
  - icon: "👩‍🏫"
    name: "Ms. Kavya"
    text: "Lead teacher, Primary Steps. Loves a good science experiment."
  - icon: "🧑‍🍳"
    name: "Chef Imran"
    text: "Cooks lunch fresh every day, and knows every allergy by heart."

cta_heading: "Want to see it for yourself?"
cta_text: "A short visit tells you more than any brochure can."
cta_button_text: "Plan Your Visit"
cta_button_link: "/admissions/"
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow-badge">{{ badge }}</span>
    <h1>{{ hero_heading }}</h1>
    <p>{{ hero_text }}</p>
  </div>
</section>

<section class="section">
  <div class="container about-split">
    <div>
      <h2>{{ approach_heading }}</h2>
      <p>{{ approach_text_1 }}</p>
      <p>{{ approach_text_2 }}</p>
    </div>
    <ul class="value-list">
      {% for v in values %}
      <li>
        <div class="dot" style="background:{{ v.color }}">{{ v.number }}</div>
        <div><strong>{{ v.title }}</strong> {{ v.text }}</div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head center">
      <h2>{{ teachers_heading }}</h2>
      <p style="margin-left:auto;margin-right:auto;">{{ teachers_subtext }}</p>
    </div>
    <div class="feature-grid">
      {% for t in teachers %}
      <div class="feature-card">
        <div class="feature-icon">{{ t.icon }}</div>
        <h3>{{ t.name }}</h3>
        <p>{{ t.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="cta-banner">
    <h2>{{ cta_heading }}</h2>
    <p>{{ cta_text }}</p>
    <a href="{{ cta_button_link }}" class="btn btn-light">{{ cta_button_text }}</a>
  </div>
</section>
