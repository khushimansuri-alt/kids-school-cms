---
layout: base.njk
title: About Us
nav: about
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow-badge">{{ about.badge }}</span>
    <h1>{{ about.hero_heading }}</h1>
    <p>{{ about.hero_text }}</p>
  </div>
</section>

<section class="section">
  <div class="container about-split">
    <div>
      <h2>{{ about.approach_heading }}</h2>
      <p>{{ about.approach_text_1 }}</p>
      <p>{{ about.approach_text_2 }}</p>
    </div>
    <ul class="value-list">
      {% for v in about.values %}
      <li>
        <div class="dot" style="background:{{ v.color }}">{{ v.number }}</div>
        <div><strong>{{ v.title }}</strong> {{ v.text }}</div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head center">
      <h2>{{ about.teachers_heading }}</h2>
      <p style="margin-left:auto;margin-right:auto;">{{ about.teachers_subtext }}</p>
    </div>
    <div class="feature-grid">
      {% for t in about.teachers %}
      <div class="feature-card">
        <div class="feature-icon">{{ t.icon }}</div>
        <h3>{{ t.name }}</h3>
        <p>{{ t.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="cta-banner">
    <h2>{{ about.cta_heading }}</h2>
    <p>{{ about.cta_text }}</p>
    <a href="{{ about.cta_button_link }}" class="btn btn-light">{{ about.cta_button_text }}</a>
  </div>
</section>
