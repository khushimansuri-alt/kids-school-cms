---
layout: base.njk
title: Contact
nav: contact
badge: "Say hello"
hero_heading: "We'd love to hear from you."
hero_text: "Questions about admissions, a visit, or just want to know more? Send a note or drop by — someone's always happy to chat."

address: "12 Maple Grove Lane, Green Park, Bhopal 462001"
phone: "+910000000000"
phone_display: "+91 00000 00000"
email: "hello@littlesparks.school"
hours: "Monday – Friday, 8:00am – 3:00pm"
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow-badge">{{ badge }}</span>
    <h1>{{ hero_heading }}</h1>
    <p>{{ hero_text }}</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <form class="contact-form">
      <div>
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div>
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div>
        <label for="child-age">Child's age</label>
        <input type="text" id="child-age" name="child-age" placeholder="e.g. 4 years">
      </div>
      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Send Message</button>
      <p class="form-note" style="font-weight:700;"></p>
    </form>

    <div class="contact-info-card">
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--coral);">📍</div>
        <div>
          <strong>Visit us</strong>
          <p style="margin:0;">{{ address }}</p>
        </div>
      </div>
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--sky);">📞</div>
        <div>
          <strong>Call us</strong>
          <p style="margin:0;"><a href="tel:{{ phone }}">{{ phone_display }}</a></p>
        </div>
      </div>
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--leaf);">✉️</div>
        <div>
          <strong>Email us</strong>
          <p style="margin:0;"><a href="mailto:{{ email }}">{{ email }}</a></p>
        </div>
      </div>
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--grape);">🕒</div>
        <div>
          <strong>School hours</strong>
          <p style="margin:0;">{{ hours }}</p>
        </div>
      </div>
      <div class="map-placeholder">Map goes here</div>
    </div>
  </div>
</section>
