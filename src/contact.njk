---
layout: base.njk
title: Contact
nav: contact
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow-badge">{{ contact.badge }}</span>
    <h1>{{ contact.hero_heading }}</h1>
    <p>{{ contact.hero_text }}</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <form class="contact-form">
      <div>
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div>
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div>
        <label for="child-age">Child's age</label>
        <input type="text" id="child-age" name="child-age" placeholder="e.g. 4 years">
      </div>
      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Send Message</button>
      <p class="form-note" style="font-weight:700;"></p>
    </form>

    <div class="contact-info-card">
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--coral);">📍</div>
        <div>
          <strong>Visit us</strong>
          <p style="margin:0;">{{ contact.address }}</p>
        </div>
      </div>
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--sky);">📞</div>
        <div>
          <strong>Call us</strong>
          <p style="margin:0;"><a href="tel:{{ contact.phone }}">{{ contact.phone_display }}</a></p>
        </div>
      </div>
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--leaf);">✉️</div>
        <div>
          <strong>Email us</strong>
          <p style="margin:0;"><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
        </div>
      </div>
      <div class="contact-info-row">
        <div class="icon-dot" style="background:var(--grape);">🕒</div>
        <div>
          <strong>School hours</strong>
          <p style="margin:0;">{{ contact.hours }}</p>
        </div>
      </div>
      <div class="map-placeholder">Map goes here</div>
    </div>
  </div>
</section>
